generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}





model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  role          String    @default("PARTNER")
  balance       Float     @default(0)
  
  // Кошелек для выплат
  walletAddress String?
  cryptoExchange String?

  // Статус аккаунта (PENDING, ACTIVE, REJECTED)
  status        String    @default("PENDING")

  
  // Для Работников и Чатеров — привязка к Банде
  bandId        String?
  band          Band?     @relation(fields: [bandId], references: [id])
  
  // Для Партнера — Банда, которой он владеет
  ownedBand     Band?     @relation("BandOwner")

  // Кто привел данного пользователя
  invitedById   String?
  invitedBy     User?     @relation("InvitedUsers", fields: [invitedById], references: [id])
  invitees      User[]    @relation("InvitedUsers")

  // Заявки кандидатов, которые ведет этот пользователь (Рекрутер)
  applications  Application[]

  // Отчеты о сменах (если роль CHATTER)
  reports       Report[]

  // Сообщения чата
  sentMessages  ChatMessage[] @relation("SentMessages")
  receivedMessages ChatMessage[] @relation("ReceivedMessages")

  // Бонусы и ставки пользователя
  bonusRates    BonusRate[]

  // Запросы на создание команды
  bandRequests  BandRequest[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Band {
  id          String   @id @default(cuid())
  name        String
  
  // Партнер-создатель банды
  ownerId     String   @unique
  owner       User     @relation("BandOwner", fields: [ownerId], references: [id])
  
  // Все участники банды (Работники и Чатеры)
  members     User[]
  
  createdAt   DateTime @default(now())
}

model Application {
  id            String            @id @default(cuid())
  name          String
  telegram      String?
  phone         String?
  
  status        String            @default("IN_PROGRESS")
  interviewDate DateTime?
  interviewText String?
  inviteToken   String?           @unique
  
  // Автоматически созданный аккаунт
  userId            String?
  generatedEmail    String?
  generatedPassword String?
  
  // Кто добавил кандидата
  recruiterId   String
  recruiter     User              @relation(fields: [recruiterId], references: [id])
  
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Report {
  id            String   @id @default(cuid())
  
  // Чатер, который отправляет отчет
  chatterId     String
  chatter       User     @relation(fields: [chatterId], references: [id])
  
  shiftStart    DateTime
  shiftEnd      DateTime
  profitAmount  Float    @default(0) 
  status        String   @default("PENDING_REVIEW") // PENDING_REVIEW, PENDING_CALCULATION, APPROVED, REJECTED
  
  // Дополнительные данные от чатера
  screenshot    String?  // Ссылка на скриншот
  accountAccess String?  // Доступы (логин/пароль)

  // Выплаты по этому отчету (заполняется при одобрении)
  chatterAmount   Float?
  recruiterAmount Float?
  ownerAmount     Float?
  adminAmount     Float?

  createdAt     DateTime @default(now())
}

model BonusRate {
  id          String   @id @default(cuid())
  amount      Float
  conditions  String
  status      String   @default("PENDING") // PENDING (ждет выполнения), PENDING_REVIEW (отчет сдан, ждет проверки), APPROVED (выплачено)
  
  // Кому назначена ставка
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  // Отчет пользователя (опционально, если есть что отправить)
  reportText  String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  text      String
  
  senderId  String
  sender    User     @relation("SentMessages", fields: [senderId], references: [id])
  
  receiverId String?
  receiver   User?   @relation("ReceivedMessages", fields: [receiverId], references: [id])
  
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BandRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  bandName    String
  description String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now())
}
